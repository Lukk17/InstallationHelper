<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by setup/manifests/generate.py. Do not edit by hand.

  The Chocolatey half of the Windows software set. Only the applications winget cannot
  serve are here, which is 10 of them, and each one's reason is a comment in
  setup/ansible/vars/Windows.yaml beside the mapping. The other 80-odd are in
  setup/manifests/configuration.winget.

  Install from an administrative shell with:

      choco install setup\manifests\packages.config -y --no-progress

  A version attribute is emitted only for a mapping that names one. See the note at the
  top of the generator.

  The wizard holds each of those at its version with Chocolatey's own pin. This file
  carries no pin, so add each one after the install, from the same shell:

      choco pin add --name=kicad --version=9.0.8
-->
<packages>
  <package id="dart-sdk" />
  <package id="filezilla" />
  <package id="glasswire" />
  <package id="gradle" />
  <package id="hwinfo.install" />
  <package id="kicad" version="9.0.8" />
  <package id="maven" />
  <package id="nvidia-app" />
  <package id="razer-synapse-4" />
  <package id="vmware-workstation-player" />
</packages>
