# See homelab/agent_access.md
PROXMOX_URL=https://<proxmox-host>:8006
PROXMOX_TOKEN_ID=<user@realm!token-name>
PROXMOX_TOKEN_SECRET=<token secret>
PROXMOX_SSH=root@<proxmox-host>
DOCKER_VM_SSH=<your-user>@<docker-vm-ip>
SYNCTHING_SERVER_URL=http://<docker-vm-ip>:7780
SYNCTHING_SERVER_API_KEY=<key from Syncthing Settings, General>
HOMELAB_SSH_KEY=~/.ssh/homelab_agent_ed25519
ASUS_ROUTER_SSH=<router-admin-user>@<router-ip>
ASUS_ROUTER_SSH_PORT=<ssh-port>
UPTIME_KUMA_URL=http://<docker-vm-ip>:7779
UPTIME_KUMA_API_KEY=<key from Uptime Kuma Settings, API Keys>
HOMEASSISTANT_URL=http://<ha-vm-ip>:8123
HOMEASSISTANT_TOKEN=<long-lived access token from the Home Assistant profile, Security tab>
