# Linux Mint 22.2 "Zara". Extracted 2026-10-18 from Mint's own package archive, inside a throwaway
# linuxmintd/mint22.2-amd64 container: base-files 13ubuntu10mint22.2.0 from
# http://packages.linuxmint.com/pool/upstream/b/base-files/base-files_13ubuntu10mint22.2.0_amd64.deb
# with sha256 9562728b4f9c6054b487bcd05a7ac7227c92ea222db0cd3ad5327ece4917e1bd matching the zara
# Packages index, unpacked with dpkg-deb. That image itself carries Ubuntu's base-files 13ubuntu10.5
# and reports ID=ubuntu, so its own /etc/os-release is not what a Mint machine has.
NAME="Linux Mint"
VERSION="22.2 (Zara)"
ID=linuxmint
ID_LIKE="ubuntu debian"
PRETTY_NAME="Linux Mint 22.2"
VERSION_ID="22.2"
HOME_URL="https://www.linuxmint.com/"
SUPPORT_URL="https://forums.linuxmint.com/"
BUG_REPORT_URL="http://linuxmint-troubleshooting-guide.readthedocs.io/en/latest/"
PRIVACY_POLICY_URL="https://www.linuxmint.com/"
VERSION_CODENAME=zara
UBUNTU_CODENAME=noble
